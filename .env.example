PORT=8080
# the site allowed to call this API (required - no default)
WEB_ORIGIN=https://idelta.com.au

# ---------------------------------------------------------------------------
# Auth (feature 1003). See the backend README, "Auth" section, for the dev
# login password and how to mint real accounts.
# ---------------------------------------------------------------------------

# Signing/encryption key for sessions and reset tokens. Generate one with
# `openssl rand -base64 32`; never reuse the dev value in prod (see
# project/setup/03-prod-environment.md, section 5 Proof).
BETTER_AUTH_SECRET=dev-only-secret-change-me-32-chars-min

# The registrable domain the session cookie is scoped to, so it is first-party
# across api.<domain> and the frontend's own subdomain (Authentication &
# Security). No leading dot -- Better Auth's crossSubDomainCookies adds it.
COOKIE_DOMAIN=idelta.com.au

# This API's own public address -- what Caddy/Fly puts it behind. Better Auth
# needs it to build absolute links (the password-reset email's URL).
API_BASE_URL=https://api.idelta.com.au

# Feature 1013 -- login rate limiting sees real client IPs, per client, instead
# of one shared bucket. The header Caddy on .41 actually sets, and the address
# .41 connects FROM as seen by this backend on .40 (project/setup/
# 01-dev-environment.md) -- so a forwarded IP is only trusted when it truly
# arrived via that hop. Prod names its own hop instead, in fly.toml [env].
AUTH_TRUSTED_IP_HEADER=x-forwarded-for
AUTH_TRUSTED_PROXIES=192.168.1.41

# What the RUNNING APP connects with. On Neon this is the POOLED string (the
# host with -pooler in it): lots of short-lived connections, which is what an
# API makes.
DATABASE_URL=postgresql://tradeservice:PASSWORD@localhost:5432/tradeservice_dev

# What the PRISMA CLI connects with -- migrate, generate, studio. On Neon this
# is the DIRECT string (no -pooler). Migrations take an advisory lock and hold
# it across statements, and a transaction pooler can hand the next statement to
# a different backend, which loses the lock. See setup/03, "Pooling on and off".
# LEAVE IT UNSET LOCALLY: .40 runs one unpooled Postgres, and prisma.config.ts
# falls back to DATABASE_URL when this is empty.
# DIRECT_URL=postgresql://tradeservice:PASSWORD@HOST/DB?sslmode=require

# The tests wipe this database at the start of every run. The name MUST end in
# _test -- the harness refuses anything else.
TEST_DATABASE_URL=postgresql://tradeservice:PASSWORD@localhost:5432/tradeservice_test

# ---------------------------------------------------------------------------
# Notification providers (feature 1004). WHICH provider sends what lives in the
# database (PlatformSettings.emailProvider / .smsProvider / .providerOverrides);
# only the secrets live here.
#
# LEAVE THESE EMPTY IN DEV. With no credentials the module falls back to the
# console adapter: the message is rendered and logged, the row still reaches
# `sent`, and the whole flow is provable with no provider accounts at all. In
# PRODUCTION the same gap refuses the boot instead of quietly logging a real
# invoice email.
# ---------------------------------------------------------------------------

# Mailjet -- transactional email (ADR 0000). The from-address must be on a
# domain authenticated at Mailjet (idelta.com.au: SPF + DKIM, done 30/08/26).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
# the From line's NAME is brand truth, not env (feature 1014) -- it comes from
# PlatformSettings.displayName on the settings screen, not from here

# ClickSend -- SMS (ADR 0000). The account itself is confirmed before the first
# real SMS build (dispatch / slot confirmation), not now.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# optional sender id / number
CLICKSEND_FROM=

PORT=8080
# the site allowed to call this API (required - no default)
WEB_ORIGIN=https://idelta.com.au

# What the RUNNING APP connects with. On Neon this is the POOLED string (the
# host with -pooler in it): lots of short-lived connections, which is what an
# API makes.
DATABASE_URL=postgresql://tradeservice:PASSWORD@localhost:5432/tradeservice_dev

# What the PRISMA CLI connects with -- migrate, generate, studio. On Neon this
# is the DIRECT string (no -pooler). Migrations take an advisory lock and hold
# it across statements, and a transaction pooler can hand the next statement to
# a different backend, which loses the lock. See setup/03, "Pooling on and off".
# LEAVE IT UNSET LOCALLY: .40 runs one unpooled Postgres, and prisma.config.ts
# falls back to DATABASE_URL when this is empty.
# DIRECT_URL=postgresql://tradeservice:PASSWORD@HOST/DB?sslmode=require

# The tests wipe this database at the start of every run. The name MUST end in
# _test -- the harness refuses anything else.
TEST_DATABASE_URL=postgresql://tradeservice:PASSWORD@localhost:5432/tradeservice_test
